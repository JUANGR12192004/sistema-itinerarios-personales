# API Gateway — variables de entorno (opcionales).
# El Dockerfile ya trae estos mismos valores por defecto. Para cambiarlos, copiar
# este archivo como .env y ejecutar el contenedor con --env-file (ver README.md).
# Nunca subir el .env al repositorio.

# Dirección (host:puerto) de cada servicio, vista DESDE el contenedor del gateway.
# Fase 7: los servicios corren en el equipo con uvicorn → host.docker.internal.
# Fase 10: el nombre del contenedor en Docker Compose (por ejemplo airport-service:8001).
AIRPORT_SERVICE_UPSTREAM=host.docker.internal:8001
ITINERARY_SERVICE_UPSTREAM=host.docker.internal:8002

# Tiempo máximo para abrir la conexión con un servicio (formato de Nginx: 2s, 500ms).
GATEWAY_PROXY_CONNECT_TIMEOUT=2s

# Tiempo máximo de espera entre dos lecturas de la respuesta de un servicio.
# Debe ser mayor que los timeouts internos de los servicios (ver ADR-009).
GATEWAY_PROXY_READ_TIMEOUT=15s

# Rate limiting por IP de origen, solo en /api/ (formato de Nginx: 10r/s, 600r/m).
GATEWAY_RATE_LIMIT=10r/s
# Solicitudes extra que se aceptan de golpe por encima del límite antes de responder 429.
GATEWAY_RATE_BURST=20

# OpenTelemetry (ADR-036, Fase 9B)
# Host del exportador OTLP gRPC (Jaeger), visto desde el contenedor del gateway.
# Fase 9: host.docker.internal (Jaeger en docker run en el equipo).
# Fase 10: el nombre del contenedor en Docker Compose (jaeger).
OTEL_EXPORTER_OTLP_HOST=host.docker.internal
# Activar o desactivar el tracing del gateway (on/off; valores que entiende Nginx).
GATEWAY_OTEL_TRACE=on
