# =============================================================================
# API Gateway del Sistema de Itinerarios Personales (Fase 7, ADR-009)
#
# Esta es una PLANTILLA. Al arrancar el contenedor, el script de la imagen oficial
# de Nginx (20-envsubst-on-templates.sh) reemplaza las variables de entorno que
# pasan el filtro NGINX_ENVSUBST_FILTER (ver Dockerfile) y guarda el resultado en
# /etc/nginx/conf.d/default.conf. Las variables propias de Nginx ($host,
# $request_id, $uri...) se escriben en minúsculas y no se tocan.
#
# El gateway NO tiene lógica de negocio: solo enruta, propaga headers, aplica
# timeouts y responde SUS PROPIOS errores con el formato de la sección 10.2.
# Los errores de los servicios (404, 422, 502, 503, 504...) pasan sin cambios.
#
# Este archivo se incluye dentro del bloque http {} de /etc/nginx/nginx.conf.
# =============================================================================


# --- Correlation ID ----------------------------------------------------------
# $request_id son 32 caracteres hexadecimales aleatorios que Nginx genera en
# cada solicitud. Se les da forma de UUID (8-4-4-4-12), como los de los servicios.
map $request_id $generated_correlation_id {
    "~^(?<cid1>[0-9a-f]{8})(?<cid2>[0-9a-f]{4})(?<cid3>[0-9a-f]{4})(?<cid4>[0-9a-f]{4})(?<cid5>[0-9a-f]{12})$"
        "$cid1-$cid2-$cid3-$cid4-$cid5";
    default $request_id;
}

# Si el cliente envía X-Correlation-ID con un formato seguro, se reutiliza.
# Si falta, o trae otros caracteres (comillas, espacios, saltos de línea...),
# el gateway genera uno nuevo: el valor se escribe dentro del JSON de los
# errores y en el log, y un texto libre podría romper ese JSON o falsear el log.
map $http_x_correlation_id $correlation_id {
    "~^[A-Za-z0-9._-]{1,128}$" $http_x_correlation_id;
    default                    $generated_correlation_id;
}

# Servicio de destino según la ruta. Solo se usa en los "details" de los
# errores del gateway, para indicar qué servicio no respondió.
map $uri $target_service {
    "~^/api/airports(/|$)"    airport-service;
    "~^/api/itineraries(/|$)" itinerary-service;
    default                   "";
}


# --- Log de acceso -----------------------------------------------------------
# Una línea por solicitud con su correlation_id (preparación de la Fase 9, donde
# pasará a JSON). Nunca incluye el header Authorization.
log_format gateway '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                   'request_time=$request_time upstream=$upstream_addr '
                   'upstream_status=$upstream_status correlation_id=$correlation_id';


# --- Servicios internos ------------------------------------------------------
# La dirección llega por variable de entorno: host.docker.internal:800X en la
# Fase 7 (servicios con uvicorn en el equipo) y el nombre del contenedor en la
# Fase 10. max_fails=0: Nginx nunca marca el servicio como "caído" por su
# cuenta; cada solicitud vuelve a intentarlo (no hay un segundo servidor).
upstream airport_service {
    server ${AIRPORT_SERVICE_UPSTREAM} max_fails=0;
}

upstream itinerary_service {
    server ${ITINERARY_SERVICE_UPSTREAM} max_fails=0;
}


server {
    listen 8000;
    server_name _;

    # No revelar la versión de Nginx en los headers ni en las páginas de error.
    server_tokens off;

    access_log /var/log/nginx/access.log gateway;

    # Tamaño máximo del cuerpo de una solicitud (un itinerario ocupa menos de 1 KB).
    client_max_body_size 1m;

    # --- Timeouts hacia los servicios ----------------------------------------
    # Conexión: si el servicio no acepta la conexión en este tiempo → 504.
    # Lectura/escritura: tiempo máximo ENTRE dos lecturas (o escrituras) seguidas.
    # Es mayor que los timeouts internos (Itinerary → Airport: 2 × 5 s; Airport →
    # API Colombia: 3 intentos de 3 s + esperas), para que el servicio alcance a
    # responder su propio error, que es más preciso.
    proxy_connect_timeout ${GATEWAY_PROXY_CONNECT_TIMEOUT};
    proxy_send_timeout    ${GATEWAY_PROXY_READ_TIMEOUT};
    proxy_read_timeout    ${GATEWAY_PROXY_READ_TIMEOUT};

    # El gateway no reintenta: los reintentos están en los servicios (Fase 2) y
    # reintentar un POST podría crear un itinerario duplicado.
    proxy_next_upstream off;

    # --- Headers que se reenvían a los servicios ------------------------------
    # (Se declaran aquí y en ninguna location: en Nginx, si una location declara
    # un proxy_set_header, deja de heredar todos los del server.)
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Correlation-ID  $correlation_id;
    # Preparación de JWT: el token se reenvía tal cual, sin validarlo todavía.
    # Si el cliente no envía el header, Nginx no lo agrega (valor vacío).
    proxy_set_header Authorization     $http_authorization;

    # Los servicios devuelven X-Correlation-ID: se oculta el suyo y se agrega el
    # del gateway (es el mismo valor), para que la respuesta lleve un solo header,
    # también en los errores propios del gateway ("always").
    proxy_hide_header X-Correlation-ID;
    add_header X-Correlation-ID $correlation_id always;

    # Si un servicio redirige (por ejemplo FastAPI: /airports/ → 307 a /airports),
    # el header Location trae la ruta interna. Se traduce a la ruta pública:
    # http://localhost:8000/airports → http://localhost:8000/api/airports.
    proxy_redirect "~^(https?://[^/]+)?/(airports|itineraries)([/?].*)?$" $1/api/$2$3;

    # --- Errores propios del gateway, en JSON ---------------------------------
    # Con proxy_intercept_errors off (valor por defecto, explícito aquí),
    # error_page solo actúa sobre los errores que genera Nginx, nunca sobre las
    # respuestas de los servicios.
    proxy_intercept_errors off;
    error_page 413 = @payload_too_large;
    error_page 502 = @upstream_unavailable;
    error_page 504 = @upstream_timeout;

    # --- Rutas ------------------------------------------------------------------

    # Reservada para el frontend (Fase 8).
    location = / {
        default_type "text/plain; charset=utf-8";
        return 200 "API Gateway del Sistema de Itinerarios Personales. El frontend llega en la Fase 8.\n";
    }

    # Salud del propio gateway (no consulta a los servicios).
    location = /health {
        default_type "application/json; charset=utf-8";
        return 200 '{"status":"ok","service":"api-gateway"}';
    }

    # /api/airports/... → Airport Service /airports/...
    # Al llevar una ruta en proxy_pass, Nginx reemplaza el prefijo de la location
    # por esa ruta: /api/airports/5?x=1 → /airports/5?x=1.
    location = /api/airports {
        proxy_pass http://airport_service/airports;
    }

    location /api/airports/ {
        proxy_pass http://airport_service/airports/;
    }

    # /api/itineraries/... → Itinerary Service /itineraries/...
    location = /api/itineraries {
        proxy_pass http://itinerary_service/itineraries;
    }

    location /api/itineraries/ {
        proxy_pass http://itinerary_service/itineraries/;
    }

    # Cualquier otra ruta no existe en el gateway.
    location / {
        default_type "application/json; charset=utf-8";
        return 404 '{"error":{"code":"ROUTE_NOT_FOUND","message":"La ruta solicitada no existe en el API Gateway","details":null},"correlation_id":"$correlation_id"}';
    }

    # --- Respuestas de error del gateway (formato de la sección 10.2) ---------

    location @payload_too_large {
        default_type "application/json; charset=utf-8";
        return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"El cuerpo de la solicitud supera el tamaño máximo permitido (1 MB)","details":null},"correlation_id":"$correlation_id"}';
    }

    location @upstream_unavailable {
        default_type "application/json; charset=utf-8";
        return 502 '{"error":{"code":"UPSTREAM_UNAVAILABLE","message":"El servicio interno no está disponible","details":{"service":"$target_service"}},"correlation_id":"$correlation_id"}';
    }

    location @upstream_timeout {
        default_type "application/json; charset=utf-8";
        return 504 '{"error":{"code":"UPSTREAM_TIMEOUT","message":"El servicio interno no respondió a tiempo","details":{"service":"$target_service"}},"correlation_id":"$correlation_id"}';
    }
}
