# Event Trigger — variables de entorno
# Copiar este archivo como .env y ajustar los valores según el entorno local.
# Nunca subir el .env al repositorio.

# RabbitMQ. Formato: amqp://usuario:clave@host:puerto/vhost  (%2F es el vhost "/")
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
# Tiempo máximo para conectar con RabbitMQ (segundos)
RABBITMQ_TIMEOUT_SECONDS=3.0
# Pausa antes de reconectar si se pierde la conexión con RabbitMQ (segundos)
RABBITMQ_RECONNECT_DELAY_SECONDS=5.0

# API de invocación de SendNotificationFunction (Runtime Interface Emulator en el puerto 9000)
FUNCTION_INVOKE_URL=http://localhost:9000/2015-03-31/functions/function/invocations
# Tiempo máximo de una invocación (segundos); mayor que el timeout de la función (10 s)
FUNCTION_TIMEOUT_SECONDS=15.0

# Política de reintentos (ADR-031)
# Intentos ante un fallo de infraestructura antes de devolver el mensaje a la cola (sin límite total)
TRIGGER_INFRASTRUCTURE_ATTEMPTS=3
# Intentos ante un error de la función antes de enviar el mensaje a la DLQ
TRIGGER_FUNCTION_ERROR_ATTEMPTS=3
# Espera inicial entre intentos; se duplica en cada intento hasta el máximo (segundos)
TRIGGER_RETRY_BACKOFF_SECONDS=1.0
TRIGGER_RETRY_MAX_BACKOFF_SECONDS=8.0
# Pausa antes de devolver el mensaje a la cola tras agotar los intentos de infraestructura (segundos)
TRIGGER_REQUEUE_DELAY_SECONDS=10.0

# Nivel de log (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
