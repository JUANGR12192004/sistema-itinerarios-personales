# Imagen de las MIGRACIONES del historial de notificaciones (Fase 10).
#
# ¿Por qué una imagen aparte? La imagen de la función (Dockerfile) no incluye Alembic a propósito
# (ADR-029): las migraciones no se aplican en cada invocación, sino una vez, como un paso del
# despliegue. En Docker Compose este paso es un contenedor de una sola ejecución
# (notification-migrations) que aplica "alembic upgrade head" y termina; la función espera a
# que termine bien antes de arrancar.
#
# Es lo mismo que hace el equipo desde el entorno virtual (README, paso "Migraciones"), pero dentro
# de un contenedor: no hace falta tener Python instalado para levantar el sistema.
#
# El contexto de build es la RAÍZ del repositorio, como las demás imágenes:
#   docker build -t notification-migrations -f serverless/send-notification-function/Dockerfile.migrations .
# El .dockerignore asociado es serverless/send-notification-function/Dockerfile.migrations.dockerignore.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/serverless/send-notification-function

# requirements-migrations.txt = dependencias de la función + Alembic, todas con versión fija.
# Las migraciones no usan libs/observability, así que no se copia.
# --only-binary :all: solo acepta paquetes ya compilados: pip no ejecuta scripts de instalación
# (reglas S8541 y S8544 de SonarCloud).
COPY serverless/send-notification-function/requirements.txt serverless/send-notification-function/requirements-migrations.txt ./
RUN pip install --only-binary :all: -r requirements-migrations.txt

# alembic/env.py importa app.config (DATABASE_URL) y los modelos de app.infrastructure.persistence
COPY serverless/send-notification-function/app ./app
COPY serverless/send-notification-function/alembic ./alembic
COPY serverless/send-notification-function/alembic.ini .

RUN useradd --system --no-create-home appuser
USER appuser

CMD ["alembic", "upgrade", "head"]
