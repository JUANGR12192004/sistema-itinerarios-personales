# SendNotificationFunction — variables de entorno
# Copiar este archivo como .env para ejecutar Alembic y las pruebas desde el equipo.
# Nunca subir el .env al repositorio.
#
# Dentro del contenedor de Lambda no hay .env: las variables se pasan con `docker run -e ...`.
# Ahí la base de datos se alcanza por la red Docker notification-net (ADR-029):
#   DATABASE_URL=postgresql+psycopg://notification:notification@notification-postgres:5432/notification_db

FUNCTION_NAME=send-notification-function

# PostgreSQL de notificaciones visto DESDE EL EQUIPO (contenedor notification-postgres, puerto 5434)
# Formato: postgresql+psycopg://usuario:clave@host:puerto/base
DATABASE_URL=postgresql+psycopg://notification:notification@localhost:5434/notification_db

# Tiempo máximo para abrir una conexión a PostgreSQL (segundos enteros, mínimo 2)
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Nivel de log de la función (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
