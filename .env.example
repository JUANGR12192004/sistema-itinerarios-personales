# Docker Compose — variables opcionales (Fase 10).
#
# docker-compose.yml ya trae estos mismos valores por defecto: el sistema arranca sin .env.
# Para cambiarlos, copiar este archivo como .env EN LA RAÍZ del repositorio (junto a
# docker-compose.yml); Compose lo lee solo al ejecutar "docker compose ...".
# Nunca subir el .env al repositorio.
#
# Cada componente tiene además su propio .env.example (services/..., serverless/..., gateway/)
# para el modo manual con entornos virtuales. Esos archivos NO los usa Docker Compose: dentro de
# Compose la configuración de cada contenedor está en la sección "environment" de docker-compose.yml.

# Nivel de log de los cuatro procesos Python (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Trazas de OpenTelemetry hacia Jaeger en los procesos Python (true | false)
OTEL_ENABLED=true

# Trazas del API Gateway (on | off, valores de Nginx)
GATEWAY_OTEL_TRACE=on

# Rate limiting del gateway por IP (formato de Nginx) y ráfaga permitida (ADR-009)
GATEWAY_RATE_LIMIT=10r/s
GATEWAY_RATE_BURST=20

# Usuario y clave de Grafana (http://localhost:3000). Solo se aplican la primera vez que
# Grafana crea su base interna; sin volumen propio, en cada "docker compose up" nuevo.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
