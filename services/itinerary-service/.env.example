# Itinerary Service — variables de entorno
# Copiar este archivo como .env y ajustar los valores según el entorno local.
# Nunca subir el .env al repositorio.

SERVICE_NAME=itinerary-service

# Cadena de conexión a PostgreSQL del servicio
# Formato: postgresql+psycopg://usuario:clave@host:puerto/base
DATABASE_URL=postgresql+psycopg://itinerary:itinerary@localhost:5433/itinerary_db

# URL de Airport Service (sin barra final)
AIRPORT_SERVICE_URL=http://localhost:8001

# Tiempo máximo de espera para una respuesta de Airport Service (segundos)
AIRPORT_SERVICE_TIMEOUT_SECONDS=5.0

# Nivel de log (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Host y puerto del servidor uvicorn.
# En producción o en Docker (Fase 10) usar HOST=0.0.0.0 para aceptar conexiones externas.
HOST=127.0.0.1
PORT=8002
