# Itinerary Service — variables de entorno
# Copiar este archivo como .env y ajustar los valores según el entorno local.
# Nunca subir el .env al repositorio.

SERVICE_NAME=itinerary-service

# Cadena de conexión a PostgreSQL del servicio
# Formato: postgresql+psycopg://usuario:clave@host:puerto/base
DATABASE_URL=postgresql+psycopg://itinerary:itinerary@localhost:5433/itinerary_db

# Tiempo máximo para abrir una conexión a PostgreSQL (segundos enteros, mínimo 2)
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# URL de Airport Service (sin barra final)
AIRPORT_SERVICE_URL=http://localhost:8001

# Tiempo máximo de espera para una respuesta de Airport Service (segundos)
AIRPORT_SERVICE_TIMEOUT_SECONDS=5.0

# RabbitMQ (Fase 4). Formato: amqp://usuario:clave@host:puerto/vhost  (%2F es el vhost "/")
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Tiempo máximo para conectar y publicar en RabbitMQ (segundos)
RABBITMQ_TIMEOUT_SECONDS=3.0

# Outbox Relay (Fase 5): proceso aparte que publica los eventos pendientes de la outbox.
# Se ejecuta con: python -m app.outbox_relay
# Cada cuántos segundos revisa la tabla outbox_events
OUTBOX_RELAY_POLL_INTERVAL_SECONDS=2.0
# Máximo de eventos pendientes por ciclo (mínimo 1)
OUTBOX_RELAY_BATCH_SIZE=10

# Nivel de log (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Host y puerto del servidor uvicorn.
# En producción o en Docker (Fase 10) usar HOST=0.0.0.0 para aceptar conexiones externas.
HOST=127.0.0.1
PORT=8002

# Puerto del servidor HTTP de métricas del Outbox Relay (Fase 9C, ADR-038).
# El relay corre como proceso separado; Prometheus consulta este puerto.
OUTBOX_RELAY_METRICS_PORT=9101

# --- Trazas (Fase 9, ADR-035): API y Outbox Relay ---
# Estas dos variables las lee OpenTelemetry directamente del entorno del proceso, NO de este
# archivo: escribirlas en .env no tiene efecto. Se asignan en la terminal antes de arrancar
# cada proceso (la API y el relay):
#   PowerShell: $env:OTEL_ENABLED = "false"   CMD: set OTEL_ENABLED=false   zsh: export OTEL_ENABLED=false
# En Docker Compose ya las define docker-compose.yml.
#
# false desactiva por completo el envío de trazas (por defecto: true)
# OTEL_ENABLED=true
# Dirección OTLP gRPC a la que se envían las trazas (Jaeger). Por defecto: http://localhost:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
