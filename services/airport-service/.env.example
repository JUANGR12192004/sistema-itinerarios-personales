# Copiar como .env y ajustar si hace falta. El archivo .env no se sube al repositorio.

# Nombre del servicio (aparece en GET /health)
SERVICE_NAME=airport-service

# URL base de API Colombia (sin barra final)
API_COLOMBIA_BASE_URL=https://api-colombia.com/api/v1

# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Resiliencia (Fase 2) ---

# Timeout: segundos máximos de espera de cada llamada a API Colombia
API_COLOMBIA_TIMEOUT_SECONDS=3

# Retry: intentos totales (1 = sin reintentos) y esperas del exponential backoff (0.5 s, 1 s, 2 s... hasta el máximo)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=4

# Circuit breaker: fallos seguidos que abren el circuito y segundos que permanece abierto
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# --- Caché (Fase 2) ---

# Conexión a Redis y tiempo máximo de espera de cada operación (si Redis falla, el servicio sigue sin caché)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=0.5

# Segundos que un dato se considera fresco (10 minutos)
CACHE_TTL_SECONDS=600
# Segundos que se guarda la copia de respaldo usada como fallback si API Colombia falla (24 horas)
CACHE_STALE_TTL_SECONDS=86400
